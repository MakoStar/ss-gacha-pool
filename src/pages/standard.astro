---
import BaseLayout from '../layouts/BaseLayout.astro'
import GoodsAvatar from '../components/goods/GoodsAvatar.astro'
import { buildStandard, stelladbUrl } from '../lib/data'
import type { GoodsEntry } from '../lib/types'
import { bannerChain } from '../lib/assets'
import { goodsCardHtml } from '../lib/card'
import { localized } from '../lib/i18n'

const { groups, catalog, pools } = buildStandard()
const card = (goods: GoodsEntry) => goodsCardHtml(goods, { lang: 'CN' })
const nameOf = (goods: GoodsEntry) => localized(goods.i18n?.name, 'CN') || goods.name
const coverOf = (file: string | null) => bannerChain(file, 'CN')

const years = [...new Set(groups.map((group) => group.date.slice(0, 4)))]
const monthsOf = (year: string) => [...new Set(
  groups.filter((group) => group.date.startsWith(year)).map((group) => group.date.slice(0, 7))
)]
const labelOf = (key: string) => `${Number(key.slice(5))} 月`
const kindOf = (kind: 'trekker' | 'disc') => kind === 'trekker' ? '旅人常驻' : '秘纹常驻'

const sections = [
  { pool: pools.trekker, list: catalog.trekker },
  { pool: pools.disc, list: catalog.disc }
]
---

<BaseLayout title="常驻池" active="standard" description="Stella Sora 常驻池新增货物、入池时间线与全部常驻货物">
  <section class="page-head">
    <h1>常驻池</h1>
    <p>常驻池新增货物与入池时间线</p>
  </section>

  <section class="std-group glass-panel">
    <h2 class="std-group-title"><span>新增入池时间线</span></h2>
    <div class="std-arrivals">
      {years.map((year) => (
        <div class="std-year">
          <h3 class="std-year-head"><span>{year}</span><em>{monthsOf(year).length} 个月</em></h3>
          {monthsOf(year).map((key) => {
            const monthGroups = groups.filter((group) => group.date.startsWith(key))
            return (
              <div class="std-month">
                <header class="std-month-head">
                  <span class="tl-month-dot"></span>
                  <h4>{labelOf(key)}</h4>
                  <span class="tl-month-count">{monthGroups.length} 项入池</span>
                </header>
                <div class="std-month-list">
                  {monthGroups.map((group) => {
                    const cover = coverOf(group.bannerFile)
                    return (
                      <article class="period-card std-arrival-card">
                        <header class="pc-head">
                          <span class="pc-date">{group.date}</span>
                          <span class="pc-days">{kindOf(group.kind)} · {group.reason}</span>
                        </header>
                        <button type="button" class="pc-pool" data-action="details" data-banner-id={group.bannerId ?? undefined}>
                          <span class="pc-thumb">
                            {cover ? (
                              <img
                                src={cover.src}
                                data-banner-file={group.bannerFile ?? ''}
                                data-img-chain={cover.chain.length > 0 ? encodeURIComponent(JSON.stringify(cover.chain)) : undefined}
                                data-fallback-name={group.source}
                                alt={group.source}
                                loading="lazy"
                                decoding="async"
                              />
                            ) : (
                              <span class="is-missing" role="img" aria-label={group.source}></span>
                            )}
                          </span>
                          <span class="pc-main">
                            <span class="pc-name">{group.source}</span>
                            <span class="pc-ups">
                              {group.goods.map((goods) => <GoodsAvatar goods={goods} />)}
                            </span>
                          </span>
                        </button>
                      </article>
                    )
                  })}
                </div>
              </div>
            )
          })}
        </div>
      ))}
    </div>
  </section>

  {sections.map(({ pool, list }) => {
    const cover = coverOf(pool.bannerFile)
    return (
      <section class="std-group glass-panel">
        <h2 class="std-group-title">
          <button type="button" class="std-pool-link" data-action="details" data-banner-id={pool.id || undefined}>
            {cover ? (
              <span class="std-pool-cover"><img src={cover.src} data-banner-file={pool.bannerFile ?? ''} data-fallback-name={pool.name} alt={pool.name} loading="lazy" decoding="async" /></span>
            ) : (
              <span class="std-pool-cover is-missing" role="img" aria-label={pool.name}></span>
            )}
            <span>{pool.name}</span>
          </button>
        </h2>
        {list.map((group) => (
          <div class="panel-group">
            <div class="panel-group-head">
              <span>{group.label}</span>
              <span class="panel-group-count">{group.goods.length}</span>
            </div>
            <div class="card-grid">
              {group.goods.map((goods) => (
                <a class="std-mini-cell" href={stelladbUrl(goods)} target="_blank" rel="noreferrer" title={nameOf(goods)} set:html={card(goods)} />
              ))}
            </div>
          </div>
        ))}
      </section>
    )
  })}
</BaseLayout>
