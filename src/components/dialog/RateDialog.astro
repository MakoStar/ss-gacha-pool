---
import { t, type Lang } from '../../lib/i18n'

interface Props {
  lang?: Lang
}

const { lang = 'CN' } = Astro.props
---

<dialog id="rate-dialog" class="rate-dialog" aria-labelledby="rate-dialog-title">
  <div class="dialog-shell">
    <header class="dialog-header">
      <span class="pin-icon" aria-hidden="true">◈</span>
      <h2 id="rate-dialog-title" data-i18n="dialog.title">{t(lang, 'dialog.title')}</h2>
      <button type="button" class="dialog-close" data-action="close-dialog" aria-label={t(lang, 'dialog.close')}>×</button>
    </header>

    <nav class="dialog-tabs" role="tablist">
      <button type="button" class="dialog-tab is-active" data-dialog-tab="goods" role="tab" data-i18n="dialog.tab.goods">
        {t(lang, 'dialog.tab.goods')}
      </button>
      <button type="button" class="dialog-tab" data-dialog-tab="probability" role="tab" data-i18n="dialog.tab.probability">
        {t(lang, 'dialog.tab.probability')}
      </button>
    </nav>

    <div class="dialog-body" id="rate-dialog-body" tabindex="-1">
      <p class="dialog-loading">—</p>
    </div>

    <div class="dialog-footer" id="rate-dialog-footer"></div>
  </div>
</dialog>
